#!/usr/bin/env bash

set -eo pipefail

# Remove all UKI files
declare -g REMOVE_ALL=1

# Set of kernel unames/paths
declare -A kernels

# An array of sorted pkgbases
declare -a sorted_pkgbases=()

while read -r line; do
  case "$line" in
    usr/bin/booster-um)
      (( REMOVE_ALL )) && REMOVE_ALL=0
      ;;
    usr/lib/modules/*/vmlinuz)
      if (( REMOVE_ALL )); then
        modules_suffix="${line#usr/lib/modules/}"
        uname="${modules_suffix%/vmlinuz}"
        kernels["$uname"]=1
      fi
      ;;
  esac
done

# Remove all booster-um UKI files
if (( REMOVE_ALL == 0 )); then exec booster-um -R; fi

# Get sorted pkgbases
mapfile -t sorted_pkgbases < <(
  for uname in "${!kernels[@]}"; do
    pkgbase_file="/usr/lib/modules/${uname}/pkgbase"

    if ! pacman -Qqo -- "$pkgbase_file" > /dev/null 2>&1; then
      continue
    fi

    read -r pkgbase < "$pkgbase_file"
    printf '%s\n' "$pkgbase"
  done | sort
)

# Remove UKI for specified kernels
export REMOVE_EFI=1; exec booster-um -r "${sorted_pkgbases[@]}"