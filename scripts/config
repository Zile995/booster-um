#!/usr/bin/env bash

set -e

# Disable sbsign by default
declare -g SBSIGN=1

# A value of 0 means that the booster-um config is valid
declare -g CONFIG_VALID=0

# Array with initramfs configs
declare -A initramfs_config

# Configs
readonly CONFIG=/etc/booster-um.yaml
readonly BOOSTER_CONFIG=/etc/booster.yaml

# Set the default Arch Linux splash
readonly ARCH_SPLASH=/usr/share/systemd/bootctl/splash-arch.bmp

# Checks if booster-um.yaml config is valid
_init_config() {
  if [[ ! -e $CONFIG ]]; then
    CONFIG_VALID=1
    $_msg_error "${Y}$CONFIG${NC} config file ${R}doesn't exist${NC}. ${Y}Default${NC} configuration is used."
  elif  [[ ! -s $CONFIG ]] || ! yq -e . "$CONFIG" 1>/dev/null; then
    CONFIG_VALID=1
    $_msg_error "${Y}$CONFIG${NC} config file ${R}is empty or not valid${NC}. ${Y}Default${NC} configuration is used."
    _print_divider
  else
    CONFIG_VALID=0
  fi
  
  # shellcheck disable=SC2034
  if ! _should_enable_colors; then
    W="$NC"
    R="$NC"
    G="$NC"
    B="$NC"
    Y="$NC"
  fi

  _set_signing_tool
}

# Sets the default signing tool
_set_signing_tool() {
  (( CONFIG_VALID )) && return
  # shellcheck disable=SC2034
  if _command_exists sbsign && _is_enabled_parameter "sbsign"; then SBSIGN=0; fi
}

# Checks if config has parameter
_has_config_parameter() {
  local parameter="$1"
  yq -e ". | has(\"${parameter}\")" "$CONFIG" &> /dev/null
}

# Checks if parameter is enabled
_is_enabled_parameter() {
  local parameter="$1"
  yq -e ".${parameter} == true" "$CONFIG" &> /dev/null
}

# Checks if config is valid
_is_config_valid() {
  (( ! CONFIG_VALID ))
}

# Checks if colors are enabled
_should_enable_colors() {
  [[ -z $colors ]] || return "$colors"
  if ! _is_config_valid || ! _has_config_parameter "colors"; then
    colors=0; return 0
  fi
  _is_enabled_parameter "colors"; colors=$?; return "$colors"
}

# Checks if the verbose parameter is enabled for the booster
_verbose() {
  [[ -z $verbose ]] || return "$verbose"
  if ! _is_config_valid || ! _has_config_parameter "verbose"; then
    verbose=1; return 1
  fi
  _is_enabled_parameter "verbose"; verbose=$?; return "$verbose"
}

# Checks if booster should use less memory.
# Booster should generate initramfs one by one (not in parallel)
_low_memory() {
  [[ -z $low_memory ]] || return "$low_memory"
  if ! _is_config_valid || ! _has_config_parameter "low_memory" || _verbose; then
    low_memory=1; return 1
  fi
  _is_enabled_parameter "low_memory"; low_memory=$?; return "$low_memory"
}

# Checks if booster-um should include microcode files.
_include_microcode() {
  [[ -z $microcode ]] || return "$microcode"
  if ! _is_config_valid || ! _has_config_parameter "microcode"; then
    microcode=0; return 0
  fi
  _is_enabled_parameter "microcode"; microcode=$?; return "$microcode"
}

# Checks if the creation of universal images is enabled
_is_universal() {
  yq -e '.universal == true' "$BOOSTER_CONFIG" &> /dev/null
}

# Checks if the splash should be enabled
_should_enable_splash() {
  [[ -z $enable_splash ]] || return "$enable_splash"
  if ! _is_config_valid || ! _has_config_parameter "enable_splash"; then
    enable_splash=0; return 0
  fi
  _is_enabled_parameter "enable_splash"; enable_splash=$?; return "$enable_splash"
}

# Checks if the booster-um should always generate a fallback UKI
# The booster-um config has higher priority and overrides main booster configuration
_should_generate_fallback() {
  [[ -z $generate_fallback ]] || return "$generate_fallback"
  if _is_config_valid && _has_config_parameter "generate_fallback"; then
    _is_enabled_parameter "generate_fallback"
  else
    _is_universal
  fi
  generate_fallback=$?
  return "$generate_fallback"
}

# Checks if the booster-um should always sign generated UKI
_should_sign_uki() {
  [[ -z $sign_uki ]] || return "$sign_uki"
  if ! _is_config_valid || ! _has_config_parameter "sign_uki"; then
    sign_uki=0; return 0
  fi
  _is_enabled_parameter "sign_uki"; sign_uki=$?; return "$sign_uki"
}

# Checks if the booster-um should remove leftovers (vmlinuz and initramfs)
_should_remove_leftovers() {
  [[ -z $remove_leftovers ]] || return "$remove_leftovers"
  if ! _is_config_valid || ! _has_config_parameter "remove_leftovers"; then
    remove_leftovers=0; return 0
  fi
  _is_enabled_parameter "remove_leftovers"; remove_leftovers=$?; return "$remove_leftovers"
}

# Checks if the booster-um should create EFI entry
_should_append_machine_id() {
  [[ -z $append_machine_id ]] || return "$append_machine_id"
  if ! _is_config_valid || ! _has_config_parameter "append_machine_id"; then
    append_machine_id=1; return 1
  fi
  _is_enabled_parameter "append_machine_id"; append_machine_id=$?; return "$append_machine_id"
}

# Checks if the booster-um should create EFI entry
_should_create_efi_entry() {
  [[ -z $efistub ]] || return "$efistub"
  if ! _is_config_valid || ! _has_config_parameter "efistub"; then
    efistub=1; return 1
  fi
  _is_enabled_parameter "efistub"; efistub=$?; return "$efistub"
}

# Checks if the booster-um should append EFI entries to the boot order
_should_append_entries() {
  [[ -z $append_entries ]] || return "$append_entries"
  if ! _is_config_valid || ! _has_config_parameter "append_entries"; then
    append_entries=0; return 0
  fi
  _is_enabled_parameter "append_entries"; append_entries=$?; return "$append_entries"
}

# Returns the default EFI entry
_get_default_entry() {
  [[ -n $default_entry ]] || \
    default_entry="$(yq ".efistub_config.default_entry" "$CONFIG" 2>/dev/null)"
  [[ $default_entry == null || -z $default_entry ]] && return
  echo "$default_entry"
}

# Returns the UKI file prefix
_get_os_id() {
  [[ -n $config_os_id ]] || config_os_id="$(yq ".os_id" "$CONFIG" 2>/dev/null)"
  if [[ $config_os_id == null || -z $config_os_id ]]; then
    config_os_id="$(grep -Po '(?<=^ID=).*' /etc/os-release)"
  fi
  echo "$config_os_id"
}

# Returns the OS name
_get_os_name() {
  [[ -n $config_os_name ]] || \
    config_os_name="$(yq ".efistub_config.os_name" "$CONFIG" 2>/dev/null)"
  if [[ $config_os_name == null || -z $config_os_name ]]; then
    config_os_name="$(grep -Po '(?<=^NAME=").*(?=")' /etc/os-release)"
  fi
  echo "$config_os_name"
}

# Returns the base cmdline
_get_config_cmdline() {
  if [[ -z $config_cmdline ]]; then
    config_cmdline="$(yq ".cmdline" "$CONFIG" 2>/dev/null)"
    [[ $config_cmdline == null || -z $config_cmdline ]] && return
  fi
  echo "$config_cmdline"
}

# Returns the base fallback cmdline
_get_config_fallback_cmdline() {
  if [[ -z $config_fallback_cmdline ]]; then
    config_fallback_cmdline="$(yq ".fallback_cmdline" "$CONFIG" 2>/dev/null)"
    [[ $config_fallback_cmdline == null || -z $config_fallback_cmdline ]] && return
  fi
  echo "$config_fallback_cmdline"
}

# Returns the pkgbase cmdline
_get_config_pkgbase_cmdline() {
  local pkgbase="$1"
  local fallback="$2"
  local config_cmdline_name config_pkgbase_cmdline

  if ! _is_config_valid; then return; fi

  [[ $fallback -eq 1 ]] && config_cmdline_name="cmdline" || config_cmdline_name="fallback_cmdline"

  config_pkgbase_cmdline="$(yq ".kernel_config.${pkgbase}.${config_cmdline_name}" "$CONFIG")"
  
  if [[ $fallback -eq 0 && -z "${config_pkgbase_cmdline// }" ]]; then
    config_pkgbase_cmdline="$(yq ".kernel_config.${pkgbase}.cmdline" "$CONFIG")"
  fi
  
  if [[ $config_pkgbase_cmdline == null ]]; then return; fi

  echo "$config_pkgbase_cmdline"
}

# Checks if the default cmdline should be shared with the pkgbase cmdlines
_should_share_default_cmdline() {
  [[ -z $share_default_cmdline ]] || return "$share_default_cmdline"
  if ! _is_config_valid || ! _has_config_parameter "share_default_cmdline"; then
    share_default_cmdline=1; return 1
  fi
  _is_enabled_parameter "share_default_cmdline"; share_default_cmdline=$?; return "$share_default_cmdline"
}

# Checks if the booster-um should create cmdline per kernel
_cmdline_per_kernel() {
  [[ -z $cmdline_per_kernel ]] || return "$cmdline_per_kernel"
  if ! _is_config_valid || ! _has_config_parameter "cmdline_per_kernel"; then
    cmdline_per_kernel=1; return 1
  fi
  _is_enabled_parameter "cmdline_per_kernel"; cmdline_per_kernel=$?; return "$cmdline_per_kernel"
}

# Returns the pkgbase booster config
_get_booster_config() {
  local pkgbase="$1"
  local booster_config
  booster_config="$(yq ".kernel_config.${pkgbase}.booster_config" "$CONFIG" 2>/dev/null)"
  [[ $booster_config == null || -z $booster_config ]] && return
  printf '%s\n' "$booster_config"
}

# Returns the sbsign property value
_get_sbsign_property() {
  local property="$1" 
  local value
  value="$(yq ".sbsign_config.$property" "$CONFIG" 2>/dev/null)"
  [[ $value == null || -z $value ]] && return
  echo "$value"
}

# Checks if the splash file is a BMP file
_is_bmp() {
  local splash="$1"
  # If the the splash exists and is a BMP file, return
  if [[ -e $splash && $(file -b --mime-type "$splash") == 'image/bmp' ]]; then return; fi
  $_msg_warn "Splash file: $splash is not a bmp file." >&2; return 1
}

# Checks if pkgbase has default initramfs type
_has_default_initramfs() {
  # The key should be the pkgbase
  local key="$1"
  [[ "${initramfs_config[$key]}" =~ "default" ]]
}

# Checks if pkgbase has fallback initramfs type
_has_fallback_initramfs() {
  # The key should be the pkgbase
  local key="$1"
  [[ "${initramfs_config[$key]}" =~ "fallback" ]]
}

# Gets the default initramfs types
_get_default_initramfs_types() {
  local -n initramfs_types="$1"

  # The universal flag is enabled in the main booster config file
  # Booster will always generate fallback images, so mark them fallback and return
  if _is_universal; then
    initramfs_types=(fallback)
    return
  fi

  # If the config file is not valid, allow both types for all kernels
  if ! _is_config_valid; then
    initramfs_types=(default fallback)
    return
  fi

  # If defalt_initramfs is not specified, generate both types
  readarray initramfs_types < <(yq ".kernel_config.default_initramfs[]" "$CONFIG")
  if (( ${#initramfs_types[@]} == 0 )); then
    initramfs_types=(default fallback)
    return
  fi

  # If generation of fallback images is disabled, and default type is not specified, mark all images as default type
  if [[ ! "${initramfs_types[*]}" =~ "default" && "${initramfs_types[*]}" =~ "fallback" ]] && ! _should_generate_fallback; then
    initramfs_types=(default)
  fi
}

# Sets the initramfs config for all kernels
_set_initramfs_config() {
  local -a value=()
  for pkgbase in "${sorted_pkgbases[@]}"; do
    # Get booster config
    local booster_config
    booster_config="$(_get_booster_config "$pkgbase")"

    if _is_universal || [[ $booster_config =~ "universal: true" ]]; then
      value=(fallback)
    else
      # Get the initramfs type array for specified kernel pkgbase
      readarray value < <(yq ".kernel_config.${pkgbase}.initramfs[]" "$CONFIG")

      # If the kernel is not specified, use the default initramfs
      if ! _is_config_valid || (( ${#value[@]} == 0 )); then
        _get_default_initramfs_types value
      elif [[ ! "${value[*]}" =~ "default" && "${value[*]}" =~ "fallback" ]] && ! _should_generate_fallback; then
        value=(default)
      fi
    fi
    # Save the initramfs config for specified kernel pkgbase
    initramfs_config["$pkgbase"]="${value[*]}"
  done
}

# Returns the splash file path
_get_splash_path() {
  local splash
  local pkgbase="$1"

  # Return if splash should not be enabled
  _should_enable_splash || return 0

  # If the config file doesn't exist or is not valid, use the default arch linux splash
  if ! _is_config_valid; then echo "$ARCH_SPLASH" && return; fi

  # Set the pkgbase splash path from the config file
  local pkgbase_splash
  pkgbase_splash="$(yq ".kernel_config.${pkgbase}.splash" "$CONFIG")"

  # Disable if pkgbase splash is set to false or empty ('', "")
  if [[ $pkgbase_splash == "false" || -z $pkgbase_splash ]]; then
    return
  # Set custom pkgbase splash if present and not null
  elif [[ $pkgbase_splash != "null" ]]; then
    splash="$pkgbase_splash"
  # Fallback to global default splash settings
  else
    local default_splash
    default_splash="$(yq '.kernel_config.default_splash' "$CONFIG")"

    # Disable if default splash is set to false or empty ('', "")
    if [[ $default_splash == "false" || -z $default_splash ]]; then
      return
    # Set custom default splash if present and not null
    elif [[ $default_splash != "null" ]]; then
      splash="$default_splash"
    # Use default Arch Linux splash if omitted entirely from config
    else
      splash="$ARCH_SPLASH"
    fi
  fi

  # Validate if the selected file is a BMP, otherwise use the Arch fallback
  if _is_bmp "$splash"; then echo "$splash"; else echo "$ARCH_SPLASH"; fi
}