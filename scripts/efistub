#!/usr/bin/env bash

set -e

# EFI System Partition. Examples: /dev/nvme0n1p1, /dev/sda1
# UKI files will be created on this partition
declare -g ESP

# EFI dir path of the directory where the UKI files are located. Example: esp/EFI/Linux
declare -g EFI_DIR

# ESP partition UUID
declare -g ESP_PARTUUID

# EFI System Partition mount point. Examples: /boot, /efi, /boot/efi
declare -g ESP_MOUNT

# Sets EFI dir path
_set_efi_path() {
  local esp_path boot_path
  esp_path="$(bootctl -p)"
  boot_path="$(bootctl -x)"

  ESP_MOUNT="$esp_path"

  if [[ "$esp_path" != "$boot_path" ]]; then
    local boot_partition part_guid xbootldr_guid
    # XBOOTLDR GUID
    xbootldr_guid="bc13c2ff-59e6-4262-a352-b275fd6f7172"

    # BOOT partition. Example: /dev/nvme0n1p4
    boot_partition="$(findmnt --real -nreo source "${boot_path}")"

    # Partition GUID TYPE
    part_guid="$(partx -g -o TYPE "${boot_partition}")"

    # If boot partition has the XBOOTLDR GUID value, set the mount path
    if [[ "$part_guid" == "$xbootldr_guid" ]]; then
      ESP="$boot_partition"
      ESP_MOUNT="$boot_path"
    fi
  fi

  # Set the EFI dir where the UKI files will be saved
  EFI_DIR="${ESP_MOUNT}/EFI/Linux"

  [[ -z $ESP ]] && ESP="$(findmnt --real -nreo source "${ESP_MOUNT}")"

  # Set the ESP UUID
  ESP_PARTUUID="$(partx -g -o UUID "${ESP}")"

  # Trigger any potential automounts
  stat -- /boot /efi "$EFI_DIR" &>/dev/null || :
}

# Checks if efi entry exists
_efi_entry_exists() {
  local loader_path="$1"
  efibootmgr | grep -w "$ESP_PARTUUID" | \
  grep -Fwq -e "${loader_path}" -e "${loader_path^^}"
}

# Formats the efi path to be readable by efibootmgr
_get_loader_path() {
  local efi
  efi="$1"

  # Set loader path wihout ESP mount point.
  efi_path="${efi#"$ESP_MOUNT"}"
  # Set loader path with backslashes
  efi_path="${efi_path//\//\\}"
  echo "$efi_path"
}

# Get the UKI file path from the EFI loader path
_get_uki_path() {
  local loader_path uki_name uki_path
  loader_path="$1"

  # Remove string prefix, before last \ char
  # \EFI\LINUX\ARCH-LINUX.EFI -> ARCH-LINUX.EFI
  uki_name="${loader_path##*\\}"

  # Lowercase name
  uki_name="${uki_name,,}"

  # Set the UKI file path
  uki_path="${EFI_DIR}/${uki_name}"

  echo "$uki_path"
}

# Checks if loader file exists
_loader_file_exists() {
  local loader_path uki_path
  loader_path="$1"

  # Get the uki file path
  uki_path="$(_get_uki_path "$loader_path")"

  # Check if the UKI file exists
  [[ -f $uki_path ]]
}

# _get_efi_info - Get EFI boot info via efibootmgr
# Usage:
# _get_efi_info <type> [<pattern>] [-u] <result_var>
# Params:
#   <type>       : -n (boot numbers), -l (labels), -p (paths), -o (boot order)
#   <pattern>    : Search pattern, required for -n, -l, -p; not used with -o
#   -u           : Optional; return unique results
#   <result_var> : Name of array variable to store results (passed by name)
_get_efi_info() {
  local type="$1"
  local uniq_flag=""
  local pattern=""
  local -n result_ref
  local result=()

  # Validate type
  case "$type" in
    -n|-l|-p|-o) ;; # Do nothing
    *)
      # Return with error
      echo "Error: Invalid or missing type parameter" >&2
      return 1
    ;;
  esac

  shift

  if [[ "$type" == "-o" ]]; then
    # boot_order has no pattern
    if [[ "$1" == "-u" ]]; then
      uniq_flag="yes"
      shift
    fi
    if [[ $# -ne 1 ]]; then
      echo "Usage: _get_efi_info -o [-u] <result_ref>" >&2
      return 1
    fi
    declare -n result_ref="$1"
  else
    # Other types require pattern
    if [[ -z "$1" ]]; then
      echo "Error: Missing <pattern> for type '$type'" >&2
      return 1
    fi
    pattern="$1"
    shift

    if [[ "$1" == "-u" ]]; then
      uniq_flag="yes"
      shift
    fi

    if [[ $# -ne 1 ]]; then
      echo "Usage: _get_efi_info <type> <pattern> [-u] <result_ref>" >&2
      return 1
    fi
    declare -n result_ref="$1"
  fi

  case "$type" in
    -n)
      # Get boot numbers for specified loader path
      readarray -t result < <(efibootmgr | \
        grep -w "$ESP_PARTUUID" | grep -Fw -e "$pattern" -e "${pattern^^}" | \
        awk '{ print $1 }' | \
        sed -r 's/0+([0-9]+)/\1/g;s/Boot//;s/\*//')
      ;;
    -l)
      # Get all labels for specified loader path
      readarray -t result < <(efibootmgr | \
        grep -w "$ESP_PARTUUID" | grep -Fw -e "$pattern" -e "${pattern^^}" | \
        sed -r 's/^Boot[0-9A-Fa-f]+\*[[:space:]]*(.*)[[:space:]]+HD\(.*$/\1/')
      ;;
    -p)
      # Get all loader paths for specified loader path
      readarray -t result < <(efibootmgr | \
        grep -w "$ESP_PARTUUID" | \
        grep -Fi "$pattern" | \
        sed "s/.*)\///")
      ;;
    -o)
      # Get efibootmgr boot order
      readarray -td, result < <(efibootmgr | \
        grep -w "BootOrder" | \
        sed -r 's/0+([0-9]+)/\1/g;s/BootOrder: //')
      ;;
    *)
      echo "Unknown type: $type" >&2
      return 1
      ;;
  esac

  # Uniquify if requested
  if [[ "$uniq_flag" == "yes" ]]; then
    readarray -t result_ref < <(printf "%s\n" "${result[@]}" | sort -u)
  else
    result_ref=("${result[@]}")
  fi
}

# Returns the EFI entry label
_get_label() {
  local pkgbase uki os_name
  pkgbase="$1"
  uki="$2" 
  os_name="$(_get_os_name)"

  # If UKI file is fallback, append the -fallback string to the pkgbase name
  [[ $uki == *"${pkgbase}-fallback.efi"* ]] && pkgbase="${pkgbase}-fallback"

  # Return the label: Entry name + (pkgbase)
  echo "$os_name ($pkgbase)"
}

# Checks EFI lables, removes orhaned entries and reports if EFI entry should be added
_should_add_entry() {
  local label="$1"
  local loader_path="$2"

  # If entry exists, check the labels
  if _efi_entry_exists "$loader_path"; then
    local labels loader_paths
    # Get labels and paths
    _get_efi_info -l "$loader_path" labels
    _get_efi_info -n "$loader_path" boot_nums

    # Loop with index
    for i in "${!labels[@]}"; do
      if [[ "${labels[$i]}" != "$label" ]]; then
        # Remove the EFI label with wrong name containing the same loader path
        $_msg_warn "EFI entry name has been changed. Removing EFI entry ${Y}${labels[$i]}${NC}..."
        efibootmgr -b "${boot_nums[$i]}" -B > /dev/null
      else
        local contains=0
      fi
    done

    [[ -z $contains ]] && return
  fi
}

# Checks if the default entry should be readded with correct boot index
_should_readd_default_entry() {
  local index="$1"
  local loader_path="$2"
  shift 2
  local -a boot_order=("$@")

  local boot_nums
  _get_efi_info -n "$loader_path" -u boot_nums
  
  # Check if the default entry is not first in boot order
  [[ ! "${boot_nums[*]}" =~ ${boot_order[$index]} ]]
}

# Adds the EFI entry
_create_efi_entry() {
  # Return if efibootmgr doesn't exist
  if ! _command_exists efibootmgr || ! _should_create_efi_entry; then return; fi

  local index=0
  local status=0
  local uki pkgbase loader_path default_entry
  uki="$1"
  pkgbase="$2"

  # Get current boot order
  local boot_order
  _get_efi_info -o boot_order

  # Set loader path with backslashes
  loader_path="$(_get_loader_path "$uki")"

  # Get default entry
  default_entry="$(_get_default_entry)"

  # If the default entry exists and is not default, remove it first
  if [[ $default_entry == "$pkgbase" ]]; then
    # Check if path is a fallback image
    if [[ ! $loader_path == *"${pkgbase}.efi"* ]] && _has_default_initramfs "$pkgbase"; then
      index=1;
    fi

    if _should_readd_default_entry "$index" "$loader_path" "${boot_order[@]}"; then
      # Remove old efi entry
      _remove_efi_entry "$uki"
    fi

  # If we should append new entries to the boot list
  elif _should_append_entries; then
    # Preserve old boot order
    index="${#boot_order[@]}"
    
  # Otherwise, decide where to insert based on fallback initramfs  
  elif _pkgbase_exists "$default_entry" && [[ ${#boot_order[@]} -gt 1 ]]; then
    # If append_entries is disabled and default_entry is specified,
    # add new EFI entry to the second or third position
    if _has_fallback_initramfs "$default_entry" && \
      _should_generate_fallback; then index=2; else index=1; fi
  fi

  # Set OS label to NAME + (pkgbase): Example: Arch Linux (linux)
  local label
  label="$(_get_label "$pkgbase" "$uki")"

  # If entry exists, do not create it
  if _should_add_entry "$label" "$loader_path"; then

    local disk esp esp_number
    # Get Efi System Partition. Example: /dev/nvme0n1p1
    esp="$(findmnt --real -nreo source "${ESP_MOUNT}")"

    # Get the found boot partition disk. Example: /dev/nvme0n1
    disk="/dev/$(lsblk -r -n -o PKNAME "${esp}")"

    # Get Efi System Partition number. Example: For /dev/nvme0n1p1, the number is 1
    esp_number="$(lsblk -r -n -o KNAME "${esp}")"
    esp_number="$(</sys/class/block/"${esp_number}"/partition)"

    $_msg_info "Creating EFI entry ${G}${label}${NC}..."

    # Add the EFI entry
    if ! efibootmgr --create \
        --disk "${disk}" \
        --part "${esp_number}" \
        --index "${index:-0}" \
        --label "${label}" \
        --loader "${loader_path^^}" \
        --unicode -q; then
        $_msg_error "Unable to create EFI entry ${R}${label}${NC}..."
        status=1
    fi
  fi

  _remove_orphaned_efi_entries

  return "$status"
}

# Removes the EFI entry for specified loader path
_remove_efi_entry_by_loader_path() {
  local loader_path="$1"

  # Find all known labels
  _get_efi_info -l "$loader_path" labels

  # Find all known efibootmgr boot numbers for the specified UKI loader path
  _get_efi_info -n "$loader_path" boot_nums

  # Print the labels 
  for label in "${labels[@]}"; do
    $_msg_warn "Removing EFI entry ${Y}${label}${NC}..."
  done

  # Remove the EFI entries
  for boot_num in "${boot_nums[@]}"; do
    efibootmgr -b "$boot_num" -B > /dev/null
  done
}

# Removes the EFI entry for specified UKI
_remove_efi_entry() {
  # Return if efibootmgr doesn't exist
  if ! _command_exists efibootmgr; then return; fi

  local uki="$1"
  local labels boot_nums pkgbase loader_path
  
  # Set loader path with backslashes
  loader_path="$(_get_loader_path "$uki")"

  # Remove the entry for specified loader_path
  _remove_efi_entry_by_loader_path "$loader_path"
}

# Removes orphaned EFI entries
_remove_orphaned_efi_entries() {
  # Return if efibootmgr doesn't exist
  if ! _command_exists efibootmgr || ! _should_create_efi_entry; then exit; fi

  # Search pattern
  # This should be a EFI path
  local search
  
  # Search the paths containing esp\EFI\Linux\${os_id}-
  search="${EFI_DIR#"$ESP_MOUNT"}/$(_get_os_id)-"
  search="${search//\//\\}"

  # Get all uniqe loader paths
  local loader_paths
  _get_efi_info -p "$search" -u loader_paths

  for loader_path in "${loader_paths[@]}"; do
    if ! _loader_file_exists "$loader_path"; then
      # Remove the entry for specified loader_path
      _remove_efi_entry_by_loader_path "$loader_path"
    fi
  done
}